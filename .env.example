# ==============================================================
# WJC GLOBAL GROUP — JARVIS COMMAND CENTER CONFIGURATION
# ==============================================================

# Dashboard Web Server
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8730
JARVIS_OPEN=1

# OpenClaw Gateway Integration
# Connects to the local OpenClaw Gateway over WebSocket (Protocol v4)
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Gateway Operator Token
# Leave empty to automatically discover from ~/.openclaw/openclaw.json
OPENCLAW_GATEWAY_TOKEN=

# Default Corporate Agent (Jarvis - Group COO)
OPENCLAW_DEFAULT_AGENT=main

# Optional ElevenLabs Voice (TTS and STT)
# If unconfigured, the Command Center automatically uses the browser Web Speech API.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
